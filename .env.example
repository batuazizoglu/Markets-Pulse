DATABASE_URL=postgresql://user:password@host:5432/db
PORT=3000
SCAN_CRON=0 * * * *
TZ=Asia/Famagusta
# Optional dashboard protection
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# Public Ad Library page transport. Production uses proxy; no direct fallback.
# Keep proxy credentials in Railway Variables, never in this file or GitHub.
AD_CAPTURE_TRANSPORT=proxy
AD_CAPTURE_PROXY_URL=
AD_CAPTURE_PROXY_USERNAME=
AD_CAPTURE_PROXY_PASSWORD=
# Alternative to the single URL: JSON array of 1-5 {id,url,username?,password?}.
# Set in Railway Variables. Leave the single URL empty when using a pool.
AD_CAPTURE_PROXIES=
